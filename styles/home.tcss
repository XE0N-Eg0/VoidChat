/* =========================================================
   GLOBAL
========================================================= */

Screen {
    layout: vertical;
    background: #1E1E2E;
    color: white;
}

HomeScreen {
    layout: vertical;
    background: #1E1E2E;
}

/* =========================================================
   TABS
========================================================= */

#tabs_container {
    height: 1fr;
}

TabbedContent {
    height: 1fr;
}

TabPane {
    height: 1fr;
}

/* =========================================================
   MAIN PANEL LAYOUT
========================================================= */

.panel-container {
    layout: horizontal;
    height: 1fr;
}

/* =========================================================
   LEFT PANEL
========================================================= */

.left-panel {
    width: 30%;
    height: 1fr;

    border-right: solid #5E81AC;

    padding: 1;

    background: #181825;
}

/* =========================================================
   RIGHT PANEL
========================================================= */

.right-panel {
    width: 70%;
    height: 1fr;

    layout: vertical;

    padding: 1;

    background: #1E1E2E;
}

/* =========================================================
   PANEL TITLES
========================================================= */

.left-panel > Static:first-child {
    color: cyan;
    text-style: bold;
    margin-bottom: 1;
}

/* =========================================================
   PEER CARDS
========================================================= */

.peer-card {
    height: 6;

    margin-bottom: 1;

    padding: 1 2;

    border: round #5E81AC;

    background: #313244;

    color: white;
}

.peer-card.-active {
    background: #5E81AC;
    text-style: bold;
}

/* =========================================================
   CONTACT CARDS
========================================================= */

.contact-card {

    height: 5;

    margin-bottom: 1;

    padding: 1 2;

    border: round #5E81AC;

    background: #313244;

    color: white;

    content-align: left middle;
}

.contact-card:hover {
    background: #45475A;
}

.contact-card.-active {
    background: #5E81AC;
    color: white;
    text-style: bold;
}

/* =========================================================
   DISCOVERY RIGHT SIDE
========================================================= */

#selected-peer-info {

    height: auto;

    min-height: 10;

    padding: 1 2;

    border: round #5E81AC;

    background: #313244;

    margin-bottom: 1;
}

#incoming-requests-panel {

    height: 1fr;

    padding: 1 2;

    border: round #5E81AC;

    background: #313244;

    margin-top: 1;
}

/* =========================================================
   CHAT HISTORY
========================================================= */

#chat-history {

    height: 1fr;

    border: round #5E81AC;

    background: #2A2A40;

    padding: 1;

    margin-bottom: 1;

    overflow-y: auto;
}

/* =========================================================
   CHAT WELCOME
========================================================= */

#chat-welcome-text {

    width: 100%;

    content-align: center top;

    color: #6C7086;

    margin-bottom: 1;
}

/* =========================================================
   MESSAGE WRAPPERS
========================================================= */

.message-wrapper {

    width: 100%;

    margin-bottom: 1;
}

.message-wrapper.sent {
    align-horizontal: right;
}

.message-wrapper.received {
    align-horizontal: left;
}

/* =========================================================
   CHAT BUBBLES
========================================================= */

.chat-bubble {
    width: auto;
    max-width: 70%;
    padding: 1 2;
    border: round #5E81AC;
    background: #313244;
    color: white;
}

.message-wrapper.sent .chat-bubble {
    background: #5E81AC;
}

/* =========================================================
   INPUT AREA
========================================================= */

#chat-input-row {
    height: 5;
    layout: horizontal;
}

/* =========================================================
   MESSAGE INPUT
========================================================= */

#chat-input {
    width: 1fr;
    margin-right: 1;
    border: round #5E81AC;
    background: #181825;
}

/* =========================================================
   SEND BUTTON
========================================================= */

#send-btn {

    width: 18;

    height: 100%;
}

/* =========================================================
   CONNECT BUTTON
========================================================= */

#connect-btn {

    width: 100%;

    margin-top: 1;
}

/* =========================================================
   SCROLLBARS
========================================================= */

Scrollbar {
    background: #181825;
}

Scrollbar > .thumb {
    background: #5E81AC;
}