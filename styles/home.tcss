Screen {
    background: #0d0017;
    color: #c084fc;
}

Header {
    background: #0d0017;
    color: #a855f7;
    border-bottom: tall #3b0764;
    text-style: bold;
    height: 3;
}

HeaderIcon { color: #7c3aed; }

Footer {
    background: #0d0017;
    color: #3b0764;
    border-top: tall #3b0764;
}

Footer > .footer--key {
    background: #1e003a;
    color: #e879f9;
}

Footer > .footer--description { color: #3b0764; }

/* ─── TABS ───────────────────────────────────────────────────────── */

#tabs_container { background: #0d0017; height: 1fr; }

TabbedContent { background: #0d0017; height: 1fr; }

TabbedContent > ContentSwitcher { background: #0d0017; height: 1fr; }

Tabs {
    background: #0d0017;
    border-bottom: tall #3b0764;
    height: 3;
    padding: 0 1;
}

Tab {
    background: #0d0017;
    color: #7c3aed;
    padding: 0 4;
    text-style: bold;
}

Tab:hover { background: #170028; color: #c084fc; }

Tab.-active {
    background: #1e003a;
    color: #e879f9;
    text-style: bold underline;
}

TabPane { background: #0d0017; padding: 0; height: 1fr; }

/* ─── PANELS ─────────────────────────────────────────────────────── */

.panel-container {
    height: 1fr;
    background: #0d0017;
    padding: 1 2;
}

.left-panel {
    width: 30;
    background: #100020;
    border: tall #2d0050;
    padding: 1 1;
    scrollbar-color: #7c3aed;
    scrollbar-background: #0d0017;
    scrollbar-corner-color: #0d0017;
}

.right-panel {
    width: 1fr;
    background: #100020;
    border: tall #2d0050;
    padding: 1;
    height: 1fr;
}

/* ─── HEADINGS — targeted by ID, no ambiguity ────────────────────── */

#peers-heading {
    color: #22c55e;
    text-style: bold;
    width: 1fr;
    height: auto;
    padding: 0 0 1 0;
    margin-bottom: 1;
    border-bottom: tall #2d0050;
    background: transparent;
}

#contacts-heading {
    color: #22c55e;
    text-style: bold;
    width: 1fr;
    height: auto;
    padding: 0 0 1 0;
    margin-bottom: 1;
    border-bottom: tall #2d0050;
    background: transparent;
}

/* ─── CONTACT CARD ───────────────────────────────────────────────── */

Static.contact-card {
    background: #100028;
    border: tall #2d0050;
    color: #d8b4fe;
    padding: 0 1;
    margin: 0 0 1 0;
    height: 3;
    text-style: bold;
}

Static.contact-card:hover {
    background: #1a0035;
    border: tall #7c3aed;
    color: #f0abfc;
}

Static.contact-card.-active {
    background: #2d004d;
    border: tall #a855f7;
    color: #f0abfc;
    text-style: bold;
}

/* ─── PEER CARD ──────────────────────────────────────────────────── */

Static.peer-card {
    background: #100028;
    border: tall #2d0050;
    color: #d8b4fe;
    padding: 0 1;
    margin: 0 0 1 0;
    height: 5;
    text-style: bold;
}

Static.peer-card:hover {
    background: #1a0035;
    border: tall #7c3aed;
    color: #f0abfc;
}

Static.peer-card.-active {
    background: #2d004d;
    border: tall #a855f7;
    color: #f0abfc;
    text-style: bold;
}

/* ─── PEER DETAILS ───────────────────────────────────────────────── */

#selected-peer-info {
    color: #c084fc;
    background: #0d0017;
    border: tall #2d0050;
    padding: 1 2;
    margin-bottom: 1;
    height: auto;
    min-height: 7;
}

/* ─── CONNECT BUTTON ─────────────────────────────────────────────── */

#connect-btn {
    background: #2d004d;
    color: #e879f9;
    border: tall #a855f7;
    text-style: bold;
    width: 1fr;
    height: 3;
    margin: 0 0 1 0;
}

#connect-btn:hover { background: #4a007a; color: #f5d0fe; border: tall #d946ef; }
#connect-btn:focus { background: #4a007a; border: tall #f0abfc; color: #f5d0fe; }

/* ─── INCOMING REQUESTS ──────────────────────────────────────────── */

#incoming-requests-panel {
    color: #9d7ec9;
    background: #0d0017;
    border: tall #2d0050;
    padding: 1 2;
    height: 1fr;
}

/* ─── CHAT RIGHT PANEL ───────────────────────────────────────────── */

#chat-right-panel {
    width: 1fr;
    background: #100020;
    border: tall #2d0050;
    padding: 0;
    height: 1fr;
}

/* ─── CHAT HISTORY ───────────────────────────────────────────────── */

#chat-history {
    height: 1fr;
    background: #080012;
    padding: 1 2;
    scrollbar-color: #7c3aed;
    scrollbar-background: #080012;
    scrollbar-corner-color: #080012;
}

#chat-welcome-text {
    color: #4c1d95;
    text-align: center;
    text-style: italic;
    padding: 1 0;
    width: 1fr;
}

/* ─── MESSAGE BUBBLES ────────────────────────────────────────────── */

MessageBubble {
    height: auto;
    margin: 0 0 1 0;
    padding: 0;
    width: 1fr;
}

.message-wrapper {
    height: auto;
    padding: 0;
    width: 1fr;
}

.message-wrapper.received {
    align: left top;
    padding-right: 8;
}

.message-wrapper.received > .chat-bubble {
    background: #0f1a10;
    border: tall #1a3d1e;
    color: #86efac;
    padding: 0 2;
    min-height: 3;
    height: auto;
    width: auto;
    max-width: 55%;
}

.message-wrapper.sent {
    align: right top;
    padding-left: 8;
}

.message-wrapper.sent > .chat-bubble {
    background: #1e003a;
    border: tall #7c3aed;
    color: #c084fc;
    padding: 0 2;
    min-height: 3;
    height: auto;
    width: auto;
    max-width: 55%;
}

/* ─── CHAT INPUT ─────────────────────────────────────────────────── */

#chat-input-row {
    background: #0d0017;
    border-top: tall #3b0764;
    border-bottom: tall #3b0764;
    border-left: tall #3b0764;
    border-right: tall #3b0764;
    padding: 1 1;
    height: 7;
    align: left middle;
}

#chat-input {
    width: 1fr;
    background: #0d0017;
    border: tall #3b0764;
    color: #c084fc;
    height: 3;
    padding: 0 1;
    margin-right: 1;
    margin-top: 0;
    margin-bottom: 0;
}

#chat-input:focus {
    border: tall #a855f7;
    background: #170028;
    color: #f0abfc;
}

#chat-input > .input--placeholder { color: #6b7280; }

/* ─── SEND BUTTON ────────────────────────────────────────────────── */

#send-btn {
    background: #2d004d;
    color: #e879f9;
    border: tall #a855f7;
    text-style: bold;
    width: 14;
    height: 3;
    margin: 0;
}

#send-btn:hover { background: #4a007a; color: #f5d0fe; border: tall #d946ef; }
#send-btn:focus { background: #4a007a; border: tall #f0abfc; color: #f5d0fe; }

/* ─── BUTTONS ────────────────────────────────────────────────────── */

Button {
    background: #1a0030;
    color: #c084fc;
    border: tall #7c3aed;
    text-style: bold;
    width: 1fr;
    height: 3;
    margin: 0 0 1 0;
}

Button:hover { background: #2d004d; color: #e879f9; border: tall #c084fc; }
Button:focus { background: #2d004d; border: tall #e879f9; color: #f0abfc; }

Button.-primary { background: #2d004d; color: #e879f9; border: tall #a855f7; }
Button.-primary:hover { background: #4a007a; color: #f5d0fe; border: tall #d946ef; }

Button.-success { background: #2d004d; color: #e879f9; border: tall #a855f7; text-style: bold; }
Button.-success:hover { background: #4a007a; color: #f5d0fe; border: tall #d946ef; }

/* ─── INPUT ──────────────────────────────────────────────────────── */

Input {
    background: #0d0017;
    color: #c084fc;
    border: tall #3b0764;
    padding: 0 1;
    height: 3;
}

Input:focus { background: #170028; border: tall #a855f7; color: #f0abfc; }
Input > .input--placeholder { color: #6b7280; }

/* ─── STATIC GLOBAL ──────────────────────────────────────────────── */

Static { color: #c084fc; background: transparent; }

/* ─── SCROLLBARS ─────────────────────────────────────────────────── */

VerticalScroll {
    scrollbar-color: #7c3aed;
    scrollbar-background: #0d0017;
    scrollbar-corner-color: #0d0017;
}

ScrollableContainer {
    scrollbar-color: #7c3aed;
    scrollbar-background: #0d0017;
}

/* ─── TOAST ──────────────────────────────────────────────────────── */

Toast { background: #1e003a; color: #c084fc; border: tall #7c3aed; }
